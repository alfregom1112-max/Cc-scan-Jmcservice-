# Railway service environment. Store real values in Railway Variables, not GitHub.
PORT=8080
NODE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_RAILWAY
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jm_servicetec_events
CORS_ORIGINS=https://YOUR_NETLIFY_SITE.netlify.app

# Generate two independent random 32-byte keys and encode each as Base64.
# Do not reuse a Supabase, MongoDB, Railway, or GitHub credential here.
SCAN_DATA_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
SCAN_LOOKUP_HMAC_KEY=BASE64_32_BYTE_KEY

# Optional operational controls. Raw document numbers are never logged.
MAX_SCAN_BATCH_SIZE=100
SCAN_RATE_LIMIT_PER_MINUTE=600
# Retention is deliberately not enabled until the controller approves a policy.
