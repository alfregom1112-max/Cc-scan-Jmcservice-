# Supabase public client configuration (safe to embed only when RLS is correct).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Railway API URL (scan records, reads, and event scan metrics)
EXPO_PUBLIC_RAILWAY_API_URL=https://YOUR_RAILWAY_DOMAIN.up.railway.app

# Document images are processed locally; the Railway API receives only the
# extracted document fields needed to synchronize an event check-in.
